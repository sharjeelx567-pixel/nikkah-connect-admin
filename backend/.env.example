PORT=5000
NODE_ENV=development

# JWT Secrets for Admin Panel
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" to generate a secure secret
JWT_SECRET=your_secure_jwt_secret_here
JWT_REFRESH_SECRET=your_secure_jwt_refresh_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Default Admin Credentials
# The server will automatically create this admin account if no admins exist
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=your_secure_password_here

# Firebase Admin SDK Credentials
# Paste the contents of your serviceAccountKey.json file here (in one line if possible), or leave it empty if you provide the JSON file locally
FIREBASE_SERVICE_ACCOUNT=

# App branding — used in generated notification/message text and the admin
# console UI. Optional: both fall back to "Wud" / "Wud marry you" if unset.
APP_NAME=Wud
APP_BRAND_PHRASE=Wud marry you
